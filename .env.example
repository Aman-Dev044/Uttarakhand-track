# Copy this file to .env and fill in your values.
# NEXT_PUBLIC_* values are baked into the page at build time, so rebuild after changing them.
# Never put secrets (API keys, passwords) in NEXT_PUBLIC_* variables: they are visible in the browser.

# Production domain, no trailing slash. Used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://trekkingcompass.com

# Brand
NEXT_PUBLIC_SITE_NAME=Trekking Compass
NEXT_PUBLIC_FOUNDED_YEAR=2018

# Contact (comma-separated phone numbers)
NEXT_PUBLIC_PHONES=+91 70550 48487,+91 70550 48488
NEXT_PUBLIC_EMAIL=trekkingcompass@gmail.com

# Address
NEXT_PUBLIC_ADDRESS_LOCALITY=Dehradun
NEXT_PUBLIC_ADDRESS_REGION=Uttarakhand
NEXT_PUBLIC_ADDRESS_COUNTRY=IN

# Social profiles
NEXT_PUBLIC_TWITTER_HANDLE=trekkingcompass
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/trekkingcompass/
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/trekkingcompass/
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@trekkingcompass
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/trekkingcompass
NEXT_PUBLIC_X_URL=https://twitter.com/trekkingcompass

# External link shown in the footer
NEXT_PUBLIC_OFFICIAL_TOURISM_URL=https://www.uttarakhandtourism.gov.in/
